{
  "name": "changbu",
  "private": true,
  "version": "1.4.5",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "pnpm dev:prepare-bundle && concurrently -k \"pnpm dev:renderer\" \"pnpm dev:electron\" \"pnpm dev:app\"",
    "dev:prepare-bundle": "node ./electron/prepareDevBundle.mjs",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173",
    "dev:electron": "tsup --watch",
    "dev:app": "wait-on tcp:5173 file:dist-electron/main.cjs file:dist-electron/preload.cjs && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electronmon --watch dist-electron/main.cjs --watch dist-electron/preload.cjs dist-electron/main.cjs",
    "typecheck": "tsc -b",
    "build": "pnpm typecheck && vite build && tsup",
    "package:dir": "pnpm build && electron-builder --dir",
    "package:mac": "pnpm build && electron-builder --mac",
    "package:win": "pnpm build && electron-builder --win",
    "rebuild:native": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "test:manual-live": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run --config vite.manual-live.config.ts",
    "test:smoke-release": "pnpm test && pnpm package:dir",
    "test:watch": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.40.0",
    "@node-rs/jieba": "^2.0.1",
    "@tanstack/react-query": "^5.96.2",
    "@uiw/react-codemirror": "^4.25.9",
    "better-sqlite3": "^12.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.3",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sqlite-vec": "^0.1.7",
    "uuid": "^13.0.0"
  },
  "optionalDependencies": {
    "@node-rs/jieba-darwin-arm64": "2.0.1",
    "@node-rs/jieba-darwin-x64": "2.0.1",
    "@node-rs/jieba-win32-x64-msvc": "2.0.1",
    "sqlite-vec-darwin-arm64": "0.1.7",
    "sqlite-vec-darwin-x64": "0.1.7",
    "sqlite-vec-windows-x64": "0.1.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4.2.2",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.1",
    "wait-on": "^9.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  }
}
